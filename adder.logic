

// Dynamic adder module
module Adder() {
    inputs {
        dynamic a
        dynamic[a] b
        bit ?carry_in
    }

    outputs {
        dynamic[a] sum
        bit carry_out
    }

    gates {
        bits(a, b, sum) {
            // XOR A B
            x: new Xor()
            a, b -> x

            // XOR X CARRY_IN
            out: new Xor(sum)
            x, carry_in -> out

            // AND A B
            y: new And()
            a, b -> y

            // AND X CARRY_IN
            z: new And()
            x, carry_in -> z

            // OR Y Z
            carry_out: new Or()
            y, z -> carry_out

            carry_in: carry_out
        }
    }
}

// 2 u8 inputs
x: new IntInput(u64)
y: new IntInput(u64)
clock: new ButtonInput()
clock -> adder.clock

// Add them
adder: Adder(x, y)

// Display result
out: new IntDisplay(u64)
adder.sum -> out

// Carry out
carry: new IntDisplay(u1)
adder.carry_out -> carry

