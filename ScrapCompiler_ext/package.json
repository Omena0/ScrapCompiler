{
  "name": "scrap-logic",
  "displayName": "Scrap Logic",
  "description": "Language support for Scrap Logic (.logic) files",
  "version": "0.1.3",
  "publisher": "Omena0",
  "pricing": "Free",
  "author": {
    "name": "Omena0",
    "email": "omena0mc@gmail.com",
    "url": "https://github.com/Omena0"
  },
  "license": "Polyform Strict",
  "repository": {
    "type": "git",
    "url": "https://github.com/Omena0/ScrapCompiler"
  },
  "homepage": "https://github.com/Omena0/ScrapCompiler",
  "bugs": {
    "url": "https://github.com/Omena0/ScrapCompiler/issues/new"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:logic"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "logic",
        "aliases": [
          "Scrap Logic",
          "logic"
        ],
        "extensions": [
          ".logic"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "logic",
        "scopeName": "source.logic",
        "path": "./syntaxes/logic.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "scrapLogic.compile",
        "title": "Scrap Logic: Compile Current File"
      },
      {
        "command": "scrapLogic.visualize",
        "title": "Scrap Logic: Visualize Current File"
      }
    ],
    "keybindings": [
      {
        "command": "scrapLogic.visualize",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == logic"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.80.0",
    "pyright": "^1.1.411",
    "typescript": "^5.3.0"
  }
}
