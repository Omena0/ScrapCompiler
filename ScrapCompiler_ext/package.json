{
  "name": "scrap-logic",
  "displayName": "Scrap Logic",
  "description": "Language support for Scrap Logic (.logic) files",
  "version": "0.0.1",
  "publisher": "omena0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:logic"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "logic",
        "aliases": [
          "Scrap Logic",
          "logic"
        ],
        "extensions": [
          ".logic"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "logic",
        "scopeName": "source.logic",
        "path": "./syntaxes/logic.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "scrapLogic.compile",
        "title": "Scrap Logic: Compile Current File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
